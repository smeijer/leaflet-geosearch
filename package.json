{
  "name": "leaflet-geosearch",
  "version": "3.6.1",
  "description": "Adds support for address lookup (a.k.a. geocoding / geosearching) to Leaflet.",
  "publishConfig": {
    "tag": "latest"
  },
  "main": "dist/geosearch.js",
  "umd:main": "dist/geosearch.umd.js",
  "module": "dist/geosearch.module.js",
  "unpkg": "dist/geosearch.umd.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "amdName": "GeoSearch",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/geosearch.module.js",
      "umd": "./dist/geosearch.umd.js",
      "import": "./dist/geosearch.module.js",
      "require": "./dist/geosearch.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "browser": "./dist/providers.module.js",
      "import": "./dist/providers.module.js",
      "require": "./dist/providers.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "scripts": {
    "clean": "rimraf ./dist .docz/dist",
    "start": "concurrently npm:build:watch npm:docz:dev",
    "build": "run-p build:dist build:lib build:types build:css && npm run build:compat",
    "build:dist": "vite build && vite build --mode providers",
    "build:compat": "node scripts/copy.mjs dist/geosearch.umd.js dist/bundle.min.js",
    "build:lib": "tsc",
    "build:types": "tsc -p tsconfig.types.json",
    "build:css": "node scripts/copy.mjs assets/css/leaflet.css dist/geosearch.css",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint \"{src,test}/**/*.{js,ts,tsx}\" --quiet --fix && prettier \"**/*.{md,mdx,json}\" --write",
    "docz:dev": "docz dev",
    "docz:build": "cross-env NODE_OPTIONS=--openssl-legacy-provider docz build",
    "docz:serve": "docz build && docz serve",
    "docs:update": "run-s clean build docz:build && git checkout gh-pages && find . -maxdepth 1 -type f -not -path '*/\\.*' -delete && cp -r .docz/dist/* . && git add . && (git diff --staged --exit-code || git commit -m \"update docs\") && git checkout - && git push origin gh-pages",
    "prepublish": "run-s test clean build",
    "ci:lint": "eslint \"{src,test}/**/*.{js,ts,tsx}\"",
    "ci:tsc": "tsc --noEmit --project ./tsconfig.test.json",
    "ci:test": "vitest run",
    "ci:package": "publint --pack npm && attw --pack . --ignore-rules unexpected-module-syntax",
    "bump:patch": "npm version patch -m 'release: cut the %s release'",
    "bump:minor": "npm version minor -m 'release: cut the %s release'",
    "bump:major": "npm version major -m 'release: cut the %s release'"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/gatsby-theme-docz",
    "dist",
    "lib",
    "assets",
    "providers"
  ],
  "keywords": [
    "maps",
    "leaflet",
    "geocoding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smeijer/leaflet-geosearch.git"
  },
  "author": "Stephan Meijer <stephan@meijer.ws>",
  "bugs": {
    "url": "https://github.com/smeijer/leaflet-geosearch/issues"
  },
  "homepage": "https://leaflet-geosearch.meijer.works",
  "license": "MIT",
  "dependencies": {
    "@types/google.maps": "^3.53.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@emotion/core": "^10.3.1",
    "@types/leaflet": "^1.9.20",
    "@types/lodash.debounce": "^4.0.6",
    "@types/react-dom": "^18.0.6",
    "@types/react-leaflet": "^2.5.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^7.4.0",
    "cross-env": "^7.0.3",
    "docz": "^2.3.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "gatsby-plugin-react-leaflet": "^2.0.12",
    "happy-dom": "^21.0.4",
    "husky": "^4.2.5",
    "lint-staged": "^13.0.3",
    "msw": "^3.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-leaflet": "^2.6.3",
    "rimraf": "^3.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "leaflet": "^1.6.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
